rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Maps a signed-in user to the household they belong to.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /households/{householdId} {
      // Any signed-in user can look up a household by its code — needed to
      // join one, and to show a friendly "code not found" error.
      allow get: if request.auth != null;
      allow list: if false;

      // Create: only as the sole first member (creating your own household).
      allow create: if request.auth != null
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0] == request.auth.uid;

      // Update: existing members can change things freely; someone joining
      // can only add themselves (exactly one new member, all old ones kept).
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members
        || (
          request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
        )
      );

      allow delete: if false;

      // All the app's actual data (shopping list, recipes, profiles, etc.)
      // lives here, readable/writable only by members of this household.
      match /data/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
    }
  }
}
